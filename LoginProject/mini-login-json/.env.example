# ============================================================
#  Copie este arquivo para .env e preencha os valores
#  (Windows:  copy .env.example .env   |   Linux/Mac:  cp .env.example .env)
#  O .env NUNCA deve ser commitado - ele ja esta no .gitignore
# ============================================================

# Chave da API da OpenAI - obrigatoria p/ o chat funcionar
# Gere a sua em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-coloque_sua_chave_aqui

# Senha do banco MySQL (voce escolhe; o container cria com ela)
DB_PASSWORD=troque_esta_senha

# Nome do banco de memoria do chatbot
DB_NAME=aisha_memory

# ------------------------------------------------------------
# Abaixo so e necessario se for rodar SEM Docker (modo manual),
# apontando para um MySQL instalado na propria maquina.
# No Docker Compose esses valores sao definidos automaticamente.
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
